# Contact form (Web3Forms) — spam-protected form delivery, no backend required.
#
# How to get your free access key (takes ~1 minute, email only, no password/account):
#   1. Go to https://web3forms.com
#   2. Enter the address where you want form submissions delivered
#      (e.g. office@oppmed.com) and click "Create Access Key".
#   3. Check that inbox and copy the access key from the confirmation email.
#
# Then:
#   - Local dev: copy this file to ".env" and paste the key below.
#   - Production: add VITE_WEB3FORMS_ACCESS_KEY in the Vercel project's
#     Settings → Environment Variables, then redeploy.
#
# Note: this key is safe to expose in the frontend by design — Web3Forms controls
# spam via the honeypot + your allowed-domain settings, not by keeping the key secret.

VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here
